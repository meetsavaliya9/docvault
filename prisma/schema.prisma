generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PLUS
  PRO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique @db.VarChar(320)
  name             String?        @db.VarChar(120)
  passwordHash     String         @db.VarChar(200)
  isBlocked        Boolean        @default(false)
  stripeCustomerId String?        @unique @db.VarChar(255)
  createdAt        DateTime       @default(now())
  sessions         Session[]
  documents        Document[]
  folders          Folder[]
  trashItems       TrashItem[]
  otpChallenges    OtpChallenge[]
  subscriptions    Subscription[]
  payments         Payment[]
}

model SubscriptionPlan {
  id                String         @id @db.VarChar(40)
  slug              Plan           @unique
  name              String         @db.VarChar(80)
  price             Int
  currency          String         @default("INR") @db.VarChar(3)
  billingPeriod     String         @default("monthly") @db.VarChar(20)
  description       String         @db.VarChar(500)
  features          Json
  documentLimit     Int?
  storageLimitBytes BigInt
  isActive          Boolean        @default(true)
  isRecommended     Boolean        @default(false)
  displayOrder      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]
  payments          Payment[]

  @@index([isActive, displayOrder])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  provider             String    @default("stripe") @db.VarChar(20)
  stripeSubscriptionId String?   @unique @db.VarChar(255)
  stripePriceId        String?   @db.VarChar(255)
  planKey              Plan?
  planId               String?   @db.VarChar(40)
  status               String    @db.VarChar(40)
  startDate            DateTime?
  endDate              DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments             Payment[]

  @@index([userId, status])
  @@index([userId, planKey, endDate])
}

model Payment {
  id               String        @id @default(cuid())
  userId           String
  subscriptionId   String?
  planId           String?       @db.VarChar(40)
  planName         String        @default("") @db.VarChar(80)
  billingPeriod    String        @default("monthly") @db.VarChar(20)
  razorpayOrderId  String        @unique @db.VarChar(255)
  razorpayPaymentId String?       @unique @db.VarChar(255)
  razorpaySignature String?       @db.Char(64)
  amount           Int
  amountPaid       Int           @default(0)
  currency         String        @default("INR") @db.VarChar(3)
  status           PaymentStatus @default(PENDING)
  refundedAmount   Int           @default(0)
  plan             Plan
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planDetails      SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  refunds          PaymentRefund[]

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([planId])
}

model PaymentRefund {
  id              String   @id @default(cuid())
  razorpayRefundId String   @unique @db.VarChar(255)
  paymentId       String
  amount          Int
  currency        String   @db.VarChar(3)
  status          String   @db.VarChar(30)
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, status])
}

model SubscriptionPlanPricing {
  planKey        String   @id @db.VarChar(20)
  amount         Int
  razorpayPlanId String?  @db.VarChar(255)
  updatedAt      DateTime @updatedAt
}

model RazorpayPlan {
  providerPlanId String   @id @db.VarChar(255)
  planKey        String   @db.VarChar(20)
  amount         Int
  createdAt      DateTime @default(now())

  @@index([planKey])
}

model EmailVerification {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(320)
  name         String?  @db.VarChar(120)
  passwordHash String   @db.VarChar(200)
  otpHash      String   @db.Char(64)
  expiresAt    DateTime
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @db.Char(64)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Document {
  id                     String   @id @db.VarChar(100)
  userId                 String
  name                   String   @db.VarChar(255)
  type                   String   @db.VarChar(40)
  size                   String   @db.VarChar(40)
  rawBytes               Int      @default(0)
  modified               String   @db.VarChar(100)
  starred                Boolean  @default(false)
  deleted                Boolean  @default(false)
  folder                 String   @db.VarChar(255)
  folderSlug             String   @db.VarChar(120)
  hash                   String?  @db.VarChar(100)
  fileData               String?  @db.LongText
  cloudinaryPublicId     String?  @db.VarChar(255)
  cloudinaryResourceType String?  @db.VarChar(20)
  cloudinaryVersion      Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, folderSlug])
}

model Folder {
  id     String @id @default(cuid())
  userId String
  slug   String @db.VarChar(120)
  data   Json
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

model TrashItem {
  id     String @id @db.VarChar(100)
  userId String
  data   Json
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
