generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Document {
  id                     String   @id @db.VarChar(100)
  userId                 String
  name                   String   @db.VarChar(255)
  type                   String   @db.VarChar(40)
  size                   String   @db.VarChar(40)
  rawBytes               Int      @default(0)
  modified               String   @db.VarChar(100)
  starred                Boolean  @default(false)
  deleted                Boolean  @default(false)
  folder                 String   @db.VarChar(255)
  folderSlug             String   @db.VarChar(120)
  hash                   String?  @db.VarChar(100)
  fileData               String?  @db.LongText
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  cloudinaryPublicId     String?  @db.VarChar(255)
  cloudinaryResourceType String?  @db.VarChar(20)
  cloudinaryVersion      Int?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Document_userId_fkey")

  @@index([userId, createdAt], map: "Document_userId_createdAt_idx")
  @@index([userId, folderSlug], map: "Document_userId_folderSlug_idx")
  @@map("Document")
}

model EmailVerification {
  id           String   @id
  email        String   @unique(map: "EmailVerification_email_key") @db.VarChar(320)
  name         String?  @db.VarChar(120)
  passwordHash String   @db.VarChar(200)
  otpHash      String   @db.Char(64)
  expiresAt    DateTime
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([email], map: "EmailVerification_email_idx")
  @@index([expiresAt], map: "EmailVerification_expiresAt_idx")
  @@map("EmailVerification")
}

model Folder {
  id     String @id
  userId String
  slug   String @db.VarChar(120)
  data   String @db.LongText
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Folder_userId_fkey")

  @@unique([userId, slug], map: "Folder_userId_slug_key")
  @@map("Folder")
}

model OtpChallenge {
  id        String   @id
  userId    String
  codeHash  String   @db.Char(64)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "OtpChallenge_userId_fkey")

  @@index([expiresAt], map: "OtpChallenge_expiresAt_idx")
  @@index([userId, createdAt], map: "OtpChallenge_userId_createdAt_idx")
  @@map("OtpChallenge")
}

model Payment {
  id                String            @id
  userId            String
  subscriptionId    String?
  razorpayOrderId   String            @unique(map: "Payment_razorpayOrderId_key") @db.VarChar(255)
  razorpayPaymentId String?           @unique(map: "Payment_razorpayPaymentId_key") @db.VarChar(255)
  razorpaySignature String?           @db.Char(64)
  amount            Int
  currency          String            @default("INR") @db.VarChar(3)
  status            PaymentStatus     @default(PENDING)
  plan              String            @db.VarChar(40)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  amountPaid        Int               @default(0)
  billingPeriod     String            @default("monthly") @db.VarChar(20)
  planId            String?           @db.VarChar(40)
  planName          String            @default("") @db.VarChar(80)
  refundedAmount    Int               @default(0)
  planDetails       SubscriptionPlan? @relation(fields: [planId], references: [id], map: "Payment_planId_fkey")
  subscription      Subscription?     @relation(fields: [subscriptionId], references: [id], map: "Payment_subscriptionId_fkey")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Payment_userId_fkey")
  refunds           PaymentRefund[]

  @@index([planId], map: "Payment_planId_idx")
  @@index([subscriptionId], map: "Payment_subscriptionId_idx")
  @@index([userId, status], map: "Payment_userId_status_idx")
  @@map("Payment")
}

model PaymentRefund {
  id               String    @id
  razorpayRefundId String    @unique(map: "PaymentRefund_razorpayRefundId_key") @db.VarChar(255)
  paymentId        String
  amount           Int
  currency         String    @db.VarChar(3)
  status           String    @db.VarChar(30)
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "PaymentRefund_paymentId_fkey")

  @@index([paymentId, status], map: "PaymentRefund_paymentId_status_idx")
  @@map("PaymentRefund")
}

model RazorpayPlan {
  providerPlanId String   @id @db.VarChar(255)
  planKey        String   @db.VarChar(40)
  amount         Int
  createdAt      DateTime @default(now())

  @@index([planKey], map: "RazorpayPlan_planKey_idx")
  @@map("RazorpayPlan")
}

model Session {
  id        String   @id
  tokenHash String   @unique(map: "Session_tokenHash_key") @db.Char(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([expiresAt], map: "Session_expiresAt_idx")
  @@index([userId], map: "Session_userId_idx")
  @@map("Session")
}

model Subscription {
  id                   String            @id
  userId               String
  stripeSubscriptionId String?           @unique(map: "Subscription_stripeSubscriptionId_key") @db.VarChar(255)
  stripePriceId        String?           @db.VarChar(255)
  status               String            @db.VarChar(40)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime
  provider             String            @default("stripe") @db.VarChar(20)
  endDate              DateTime?
  planKey              String?           @db.VarChar(40)
  startDate            DateTime?
  planId               String?           @db.VarChar(40)
  payments             Payment[]
  plan                 SubscriptionPlan? @relation(fields: [planId], references: [id], map: "Subscription_planId_fkey")
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Subscription_userId_fkey")

  @@index([planId], map: "Subscription_planId_fkey")
  @@index([userId, planKey, endDate], map: "Subscription_userId_planKey_endDate_idx")
  @@index([userId, status], map: "Subscription_userId_status_idx")
  @@map("Subscription")
}

model SubscriptionPlan {
  id                String         @id @db.VarChar(40)
  slug              String         @unique(map: "SubscriptionPlan_slug_key") @db.VarChar(40)
  name              String         @unique(map: "SubscriptionPlan_name_key") @db.VarChar(80)
  price             Int
  currency          String         @default("INR") @db.VarChar(3)
  billingPeriod     String         @default("monthly") @db.VarChar(20)
  description       String         @db.VarChar(500)
  features          String         @db.LongText
  documentLimit     Int?
  storageLimitBytes BigInt
  isActive          Boolean        @default(true)
  isRecommended     Boolean        @default(false)
  displayOrder      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  razorpayPlanId    String?        @unique(map: "SubscriptionPlan_razorpayPlanId_key") @db.VarChar(255)
  payments          Payment[]
  subscriptions     Subscription[]

  @@index([isActive, displayOrder], map: "SubscriptionPlan_isActive_displayOrder_idx")
  @@map("SubscriptionPlan")
}

model SubscriptionPlanPricing {
  planKey        String   @id @db.VarChar(40)
  amount         Int
  updatedAt      DateTime
  razorpayPlanId String?  @db.VarChar(255)
  @@map("SubscriptionPlanPricing")
}

model TrashItem {
  id     String @id @db.VarChar(100)
  userId String
  data   String @db.LongText
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "TrashItem_userId_fkey")

  @@index([userId], map: "TrashItem_userId_idx")
  @@map("TrashItem")
}

model User {
  id               String           @id
  email            String           @unique(map: "User_email_key") @db.VarChar(320)
  passwordHash     String           @db.VarChar(200)
  createdAt        DateTime         @default(now())
  name             String?          @db.VarChar(120)
  isBlocked        Boolean          @default(false)
  stripeCustomerId String?          @unique(map: "User_stripeCustomerId_key") @db.VarChar(255)
  documents        Document[]
  folders          Folder[]
  otpChallenges    OtpChallenge[]
  payments         Payment[]
  sessions         Session[]
  subscriptions    Subscription[]
  trashItems       TrashItem[]
  userPermissions  UserPermission[]

  @@map("User")
}

model UserPermission {
  id         String                    @id
  userId     String
  permission Permission
  enabled    Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @default(now())
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "UserPermission_userId_fkey")

  @@unique([userId, permission], map: "UserPermission_userId_permission_key")
  @@index([permission, enabled], map: "UserPermission_permission_enabled_idx")
  @@map("userpermission")
}

enum Permission {
  VIEW_DASHBOARD
  VIEW_DASHBOARD_STATS
  VIEW_RECENT_DOCUMENTS
  VIEW_STORAGE_USAGE
  VIEW_DOCUMENTS
  UPLOAD_DOCUMENT
  DOWNLOAD_DOCUMENT
  DELETE_DOCUMENT
  PERMANENT_DELETE_DOCUMENT
  RENAME_DOCUMENT
  VIEW_DOCUMENT_DETAILS
  SEARCH_DOCUMENTS
  SEARCH_BY_NAME
  SEARCH_BY_TYPE
  SORT_DOCUMENTS
  FILTER_DOCUMENTS
  PREVIEW_DOCUMENT
  MANAGE_STARRED_DOCUMENTS
  VIEW_FOLDERS
  CREATE_FOLDER
  RENAME_FOLDER
  DELETE_FOLDER
  MOVE_DOCUMENT
  VIEW_STARRED
  RESTORE_DOCUMENT
  EMPTY_TRASH
  SHARE_DOCUMENT
  VIEW_TRASH
  VIEW_SUBSCRIPTION
  VIEW_PLANS
  CHANGE_SUBSCRIPTION
  MANAGE_SUBSCRIPTION
  VIEW_PAYMENT_HISTORY
  VIEW_NOTIFICATIONS
  MANAGE_NOTIFICATIONS
  MARK_NOTIFICATION_READ

  @@map("userpermission_permission")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status")
}
