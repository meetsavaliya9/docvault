# Database (MySQL via Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/docvault"

# Security (At least 32 random characters for OTP HMAC hashing)
OTP_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Admin accounts must already exist in the app. Use a comma-separated allowlist.
ADMIN_EMAILS="admin@example.com"

# Gmail SMTP Configuration for Email OTP Verification
# IMPORTANT:
# 1. SMTP_PASSWORD must be a 16-character Google App Password (not your normal Gmail account password).
# 2. To generate an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords.
# 3. Never commit real credentials to Git.
# 4. Never prefix these variables with NEXT_PUBLIC_.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASSWORD="your-16-character-google-app-password"
SMTP_FROM="DocVault <your-gmail-address@gmail.com>"

# Cloudinary (Media / Document Storage)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Razorpay TEST MODE only (server-side; never use NEXT_PUBLIC_ prefixes)
RAZORPAY_KEY_ID="rzp_test_your-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-test-webhook-secret"
