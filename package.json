    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.0",
    "tailwindcss": "^4"
  }
}
